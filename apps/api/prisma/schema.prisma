generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  VERIFIED
  INVALID
  DUPLICATE
  SUPPRESSED
}

enum PhoneType {
  LANDLINE
  MOBILE
  VOIP
  TOLL_FREE
  UNKNOWN
}

enum SourceType {
  GOVERNMENT_DIRECTORY
  BUSINESS_DIRECTORY
  COMPANY_WEBSITE
  LICENSED_API
  USER_IMPORT
  OTHER
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(320)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(150)
  role         UserRole      @default(USER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(3)
  scrapingJobs ScrapingJob[]
  leads        Lead[]
  auditLogs    AuditLog[]
  sessions     UserSession[]

  @@map("users")
}

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?   @map("ip_address") @db.Inet
  userAgent           String?   @map("user_agent") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model ScrapingJob {
  id                 String        @id @default(uuid()) @db.Uuid
  name               String        @db.VarChar(150)
  source             String        @default("fixture-business-directory") @db.VarChar(100)
  country            String        @default("United States") @db.VarChar(100)
  state              String?       @db.VarChar(100)
  city               String?       @db.VarChar(120)
  location           String        @default("United States") @db.VarChar(255)
  category           String?       @db.VarChar(150)
  searchQuery        String?       @map("search_query") @db.VarChar(500)
  requestedLimit     Int           @map("requested_limit")
  successCount       Int           @default(0) @map("collected_count")
  processedCount     Int           @default(0) @map("processed_count")
  failureCount       Int           @default(0) @map("failed_count")
  duplicateCount     Int           @default(0) @map("duplicate_count")
  progressPercentage Int           @default(0) @map("progress")
  status             JobStatus     @default(PENDING)
  startedAt          DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  failedAt           DateTime?     @map("failed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  errorMessage       String?       @map("failure_reason") @db.Text
  queueJobId         String?       @map("queue_job_id") @db.VarChar(255)
  retryOfJobId       String?       @map("retry_of_job_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId             String        @map("user_id") @db.Uuid
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  retryOfJob         ScrapingJob?  @relation("ScrapingJobRetries", fields: [retryOfJobId], references: [id], onDelete: SetNull)
  retries            ScrapingJob[] @relation("ScrapingJobRetries")
  leads              Lead[]

  @@unique([id, userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([retryOfJobId])
  @@index([queueJobId])
  @@map("scraping_jobs")
}

model Lead {
  id                      String      @id @default(uuid()) @db.Uuid
  businessName            String      @map("business_name") @db.VarChar(255)
  phoneRaw                String?     @map("phone_raw") @db.VarChar(50)
  phoneNormalized         String?     @map("phone_normalized") @db.VarChar(20)
  phoneType               PhoneType   @default(UNKNOWN) @map("phone_type")
  email                   String?     @db.VarChar(320)
  website                 String?     @db.VarChar(2048)
  domain                  String?     @db.VarChar(253)
  addressLine1            String?     @map("address_line_1") @db.VarChar(255)
  addressLine2            String?     @map("address_line_2") @db.VarChar(255)
  city                    String?     @db.VarChar(120)
  state                   String?     @db.VarChar(100)
  postalCode              String?     @map("postal_code") @db.VarChar(20)
  country                 String      @default("United States") @db.VarChar(100)
  category                String?     @db.VarChar(150)
  sourceType              SourceType  @map("source_type")
  sourceName              String      @map("source_name") @db.VarChar(150)
  sourceUrl               String      @map("source_url") @db.VarChar(2048)
  sourceExternalId        String?     @map("source_external_id") @db.VarChar(255)
  status                  LeadStatus  @default(NEW)
  isPublicBusinessContact Boolean     @default(true) @map("is_public_business_contact")
  collectedAt             DateTime    @default(now()) @map("collected_at") @db.Timestamptz(3)
  lastVerifiedAt          DateTime?   @map("last_verified_at") @db.Timestamptz(3)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId                  String      @map("user_id") @db.Uuid
  scrapingJobId           String      @map("scraping_job_id") @db.Uuid
  user                    User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  scrapingJob             ScrapingJob @relation(fields: [scrapingJobId, userId], references: [id, userId], onDelete: Restrict)

  @@index([phoneNormalized])
  @@index([domain])
  @@index([email])
  @@index([city, state])
  @@index([category])
  @@index([status])
  @@index([sourceType])
  @@index([userId, scrapingJobId])
  @@index([userId, createdAt])
  @@index([scrapingJobId])
  @@index([collectedAt])
  @@index([sourceExternalId])
  @@map("leads")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(255)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
