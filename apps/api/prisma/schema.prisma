generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  VERIFIED
  INVALID
  DUPLICATE
  SUPPRESSED
}

enum PhoneType {
  LANDLINE
  MOBILE
  VOIP
  TOLL_FREE
  UNKNOWN
}

enum PhoneValidationStatus {
  VALID
  POSSIBLE
  INVALID
  PLACEHOLDER
  UNVERIFIED
  NO_PHONE_FOUND
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  VERY_LOW
}

enum ExtractionMethod {
  OFFICIAL_API
  HTML_TEL_LINK
  HTML_MAILTO_LINK
  VISIBLE_TEXT
  SCHEMA_ORG
  DATASET_FIELD
  CSV_COLUMN
  LOCAL_REVALIDATION
}

enum SourceType {
  GOVERNMENT_DIRECTORY
  BUSINESS_DIRECTORY
  COMPANY_WEBSITE
  LICENSED_API
  USER_IMPORT
  GOOGLE_PLACES_API
  GOVERNMENT_DATASET
  LICENSED_DATASET
  CSV_IMPORT
  META_APPROVED_API
  YELP_APPROVED_API
  OTHER
}

enum ApprovedSourceType {
  FIXTURE
  OFFICIAL_API
  GOOGLE_PLACES_API
  PUBLIC_DIRECTORY
  GOVERNMENT_DATASET
  OFFICIAL_WEBSITE
  LICENSED_DATASET
  CSV_IMPORT
  META_APPROVED_API
  YELP_APPROVED_API
}

enum ApprovedSourceStatus {
  APPROVED
  DISABLED
  BLOCKED
  REVIEW_REQUIRED
}

enum SourceHealthStatus {
  NOT_CHECKED
  HEALTHY
  DEGRADED
  UNAVAILABLE
  CONFIGURATION_MISSING
  QUOTA_LIMITED
  BLOCKED
}

enum AcquisitionStage {
  DISCOVER_BUSINESSES
  FETCH_SOURCE_DETAILS
  DISCOVER_OFFICIAL_WEBSITE
  CRAWL_PUBLIC_CONTACT_PAGES
  EXTRACT_CONTACT_DATA
  NORMALIZE_PHONE
  VALIDATE_PHONE
  DEDUPLICATE
  SCORE_CONFIDENCE
  PERSIST_LEAD
  COMPLETE_JOB
}

enum CsvImportStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum LeadVerificationStatus {
  UNVERIFIED
  PARTIALLY_VERIFIED
  VERIFIED
  VERIFICATION_FAILED
  CONFLICTING
  STALE
  NO_CONTACT_DATA
}

enum LeadReviewStatus {
  NOT_REQUIRED
  REVIEW_REQUIRED
  IN_REVIEW
  APPROVED
  REJECTED
}

enum LeadFreshnessStatus {
  FRESH
  AGING
  STALE
  UNKNOWN
}

enum DuplicateMatchLevel {
  EXACT
  HIGH
  MEDIUM
  LOW
}

enum DuplicateCandidateStatus {
  PENDING
  CONFIRMED_DUPLICATE
  NOT_DUPLICATE
  IGNORED
}

enum QualityIssueSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum QualityIssueStatus {
  UNRESOLVED
  RESOLVED
  IGNORED
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique @db.VarChar(320)
  passwordHash           String                   @map("password_hash") @db.VarChar(255)
  fullName               String                   @map("full_name") @db.VarChar(150)
  role                   UserRole                 @default(USER)
  status                 UserStatus               @default(ACTIVE)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastLoginAt            DateTime?                @map("last_login_at") @db.Timestamptz(3)
  scrapingJobs           ScrapingJob[]
  leads                  Lead[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  targetedAuditLogs      AuditLog[]               @relation("AuditTarget")
  approvedSourcesCreated ApprovedSource[]         @relation("ApprovedSourceCreator")
  approvedSourcesUpdated ApprovedSource[]         @relation("ApprovedSourceUpdater")
  csvImports             CsvImport[]
  sessions               UserSession[]
  verifications          LeadVerification[]
  reviewedDuplicates     LeadDuplicateCandidate[]
  mergeHistories         LeadMergeHistory[]
  resolvedQualityIssues  LeadQualityIssue[]
  mergedLeads            Lead[]                   @relation("UserMergedLeads")

  // Billing relations
  billingProfile      CustomerBillingProfile?
  subscriptions       Subscription[]
  subscriptionHistory SubscriptionHistory[]
  usagePeriods        UsagePeriod[]
  usageReservations   UsageReservation[]
  invoices            Invoice[]
  payments            Payment[]

  @@map("users")
}

model UserSession {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  refreshTokenHash    String    @map("refresh_token_hash") @db.Char(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  ipAddress           String?   @map("ip_address") @db.Inet
  userAgent           String?   @map("user_agent") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  lastUsedAt          DateTime? @map("last_used_at") @db.Timestamptz(3)
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([refreshTokenHash])
  @@map("user_sessions")
}

model ScrapingJob {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String           @db.VarChar(150)
  source             String           @default("fixture-business-directory") @db.VarChar(100)
  country            String           @default("United States") @db.VarChar(100)
  state              String?          @db.VarChar(100)
  city               String?          @db.VarChar(120)
  location           String           @default("United States") @db.VarChar(255)
  category           String?          @db.VarChar(150)
  searchQuery        String?          @map("search_query") @db.VarChar(500)
  requestedLimit     Int              @map("requested_limit")
  successCount       Int              @default(0) @map("collected_count")
  processedCount     Int              @default(0) @map("processed_count")
  failureCount       Int              @default(0) @map("failed_count")
  duplicateCount     Int              @default(0) @map("duplicate_count")
  progressPercentage Int              @default(0) @map("progress")
  pipelineStage      AcquisitionStage @default(DISCOVER_BUSINESSES) @map("pipeline_stage")
  status             JobStatus        @default(PENDING)
  startedAt          DateTime?        @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  failedAt           DateTime?        @map("failed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz(3)
  errorMessage       String?          @map("failure_reason") @db.Text
  queueJobId         String?          @map("queue_job_id") @db.VarChar(255)
  retryOfJobId       String?          @map("retry_of_job_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId             String           @map("user_id") @db.Uuid
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  retryOfJob         ScrapingJob?     @relation("ScrapingJobRetries", fields: [retryOfJobId], references: [id], onDelete: SetNull)
  retries            ScrapingJob[]    @relation("ScrapingJobRetries")
  leads              Lead[]
  csvImports         CsvImport[]

  @@unique([id, userId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([retryOfJobId])
  @@index([queueJobId])
  @@map("scraping_jobs")
}

model Lead {
  id                           String                   @id @default(uuid()) @db.Uuid
  businessName                 String                   @map("business_name") @db.VarChar(255)
  phoneRaw                     String?                  @map("phone_raw") @db.VarChar(50)
  phoneNormalized              String?                  @map("phone_normalized") @db.VarChar(20)
  phoneExtension               String?                  @map("phone_extension") @db.VarChar(20)
  phoneCountryCode             String?                  @map("phone_country_code") @db.VarChar(8)
  phoneNationalFormat          String?                  @map("phone_national_format") @db.VarChar(50)
  phoneType                    PhoneType                @default(UNKNOWN) @map("phone_type")
  phoneValidationStatus        PhoneValidationStatus    @default(UNVERIFIED) @map("phone_validation_status")
  email                        String?                  @db.VarChar(320)
  website                      String?                  @db.VarChar(2048)
  domain                       String?                  @db.VarChar(253)
  addressLine1                 String?                  @map("address_line_1") @db.VarChar(255)
  addressLine2                 String?                  @map("address_line_2") @db.VarChar(255)
  city                         String?                  @db.VarChar(120)
  state                        String?                  @db.VarChar(100)
  postalCode                   String?                  @map("postal_code") @db.VarChar(20)
  country                      String                   @default("United States") @db.VarChar(100)
  category                     String?                  @db.VarChar(150)
  sourceType                   SourceType               @map("source_type")
  sourceName                   String                   @map("source_name") @db.VarChar(150)
  sourceUrl                    String                   @map("source_url") @db.VarChar(2048)
  sourceExternalId             String?                  @map("source_external_id") @db.VarChar(255)
  googlePlaceId                String?                  @map("google_place_id") @db.VarChar(255)
  officialWebsiteDomain        String?                  @map("official_website_domain") @db.VarChar(253)
  confidenceScore              Int                      @default(0) @map("confidence_score")
  confidenceLevel              ConfidenceLevel          @default(VERY_LOW) @map("confidence_level")
  qualityScore                 Int                      @default(0) @map("quality_score")
  completenessScore            Int                      @default(0) @map("completeness_score")
  verificationStatus           LeadVerificationStatus   @default(UNVERIFIED) @map("verification_status")
  reviewStatus                 LeadReviewStatus         @default(NOT_REQUIRED) @map("review_status")
  freshnessStatus              LeadFreshnessStatus      @default(UNKNOWN) @map("freshness_status")
  nextVerificationAt           DateTime?                @map("next_verification_at") @db.Timestamptz(3)
  staleAt                      DateTime?                @map("stale_at") @db.Timestamptz(3)
  primaryPhoneProvenanceId     String?                  @map("primary_phone_provenance_id") @db.Uuid
  primaryEmailProvenanceId     String?                  @map("primary_email_provenance_id") @db.Uuid
  primaryWebsiteProvenanceId   String?                  @map("primary_website_provenance_id") @db.Uuid
  canonicalLeadId              String?                  @map("canonical_lead_id") @db.Uuid
  mergedAt                     DateTime?                @map("merged_at") @db.Timestamptz(3)
  mergedByUserId               String?                  @map("merged_by_user_id") @db.Uuid
  mergeReason                  String?                  @map("merge_reason") @db.Text
  duplicateReason              String?                  @map("duplicate_reason") @db.VarChar(255)
  status                       LeadStatus               @default(NEW)
  isPublicBusinessContact      Boolean                  @default(true) @map("is_public_business_contact")
  collectedAt                  DateTime                 @default(now()) @map("collected_at") @db.Timestamptz(3)
  lastVerifiedAt               DateTime?                @map("last_verified_at") @db.Timestamptz(3)
  createdAt                    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  userId                       String                   @map("user_id") @db.Uuid
  scrapingJobId                String                   @map("scraping_job_id") @db.Uuid
  user                         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  scrapingJob                  ScrapingJob              @relation(fields: [scrapingJobId, userId], references: [id, userId], onDelete: Restrict)
  canonicalLead                Lead?                    @relation("LeadMerge", fields: [canonicalLeadId], references: [id], onDelete: SetNull)
  mergedLeads                  Lead[]                   @relation("LeadMerge")
  mergedByUser                 User?                    @relation("UserMergedLeads", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  provenance                   LeadProvenance[]
  verifications                LeadVerification[]
  primaryDuplicateCandidates   LeadDuplicateCandidate[] @relation("PrimaryLead")
  candidateDuplicateCandidates LeadDuplicateCandidate[] @relation("CandidateLead")
  canonicalMergeHistories      LeadMergeHistory[]       @relation("CanonicalLead")
  mergedMergeHistories         LeadMergeHistory[]       @relation("MergedLead")
  qualityIssues                LeadQualityIssue[]

  @@index([phoneNormalized])
  @@index([phoneValidationStatus])
  @@index([domain])
  @@index([officialWebsiteDomain])
  @@index([googlePlaceId])
  @@index([userId, googlePlaceId])
  @@index([confidenceLevel, confidenceScore])
  @@index([qualityScore])
  @@index([completenessScore])
  @@index([verificationStatus])
  @@index([reviewStatus])
  @@index([freshnessStatus])
  @@index([nextVerificationAt])
  @@index([canonicalLeadId])
  @@index([email])
  @@index([city, state])
  @@index([category])
  @@index([status])
  @@index([sourceType])
  @@index([userId, scrapingJobId])
  @@index([userId, createdAt])
  @@index([scrapingJobId])
  @@index([collectedAt])
  @@index([sourceExternalId])
  @@map("leads")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  action       String   @db.VarChar(100)
  entityType   String   @map("entity_type") @db.VarChar(100)
  entityId     String?  @map("entity_id") @db.VarChar(255)
  metadata     Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actorId      String?  @map("actor_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser   User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ApprovedSource {
  id                       String               @id @default(uuid()) @db.Uuid
  key                      String               @unique @db.VarChar(100)
  displayName              String               @map("display_name") @db.VarChar(150)
  sourceType               ApprovedSourceType   @map("source_type")
  baseUrl                  String?              @map("base_url") @db.VarChar(2048)
  status                   ApprovedSourceStatus @default(REVIEW_REQUIRED)
  isEnabled                Boolean              @default(false) @map("is_enabled")
  requiresApiKey           Boolean              @default(false) @map("requires_api_key")
  allowsAutomatedAccess    Boolean              @default(false) @map("allows_automated_access")
  requestsPerMinute        Int                  @default(10) @map("requests_per_minute")
  maxConcurrency           Int                  @default(1) @map("max_concurrency")
  robotsPolicyCheckedAt    DateTime?            @map("robots_policy_checked_at") @db.Timestamptz(3)
  termsReviewedAt          DateTime?            @map("terms_reviewed_at") @db.Timestamptz(3)
  reviewNotes              String?              @map("review_notes") @db.Text
  blockedReason            String?              @map("blocked_reason") @db.Text
  lastHealthCheckAt        DateTime?            @map("last_health_check_at") @db.Timestamptz(3)
  lastHealthCheckStatus    SourceHealthStatus   @default(NOT_CHECKED) @map("last_health_check_status")
  lastHealthCheckMessage   String?              @map("last_health_check_message") @db.VarChar(500)
  lastHealthCheckLatencyMs Int?                 @map("last_health_check_latency_ms")
  lastSuccessfulRequestAt  DateTime?            @map("last_successful_request_at") @db.Timestamptz(3)
  recentFailureCount       Int                  @default(0) @map("recent_failure_count")
  quotaLimitedUntil        DateTime?            @map("quota_limited_until") @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdByUserId          String?              @map("created_by_user_id") @db.Uuid
  updatedByUserId          String?              @map("updated_by_user_id") @db.Uuid
  createdBy                User?                @relation("ApprovedSourceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                User?                @relation("ApprovedSourceUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  provenance               LeadProvenance[]
  csvImports               CsvImport[]

  @@index([status, isEnabled])
  @@index([sourceType])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@map("approved_sources")
}

model LeadProvenance {
  id                     String                @id @default(uuid()) @db.Uuid
  leadId                 String                @map("lead_id") @db.Uuid
  approvedSourceId       String?               @map("approved_source_id") @db.Uuid
  sourceKey              String                @map("source_key") @db.VarChar(100)
  sourceType             ApprovedSourceType    @map("source_type")
  sourceRecordId         String?               @map("source_record_id") @db.VarChar(255)
  sourceUrl              String?               @map("source_url") @db.VarChar(2048)
  sourceCollectedAt      DateTime              @default(now()) @map("source_collected_at") @db.Timestamptz(3)
  sourceLastCheckedAt    DateTime?             @map("source_last_checked_at") @db.Timestamptz(3)
  sourceConfidenceScore  Int                   @default(0) @map("source_confidence_score")
  verificationStatus     PhoneValidationStatus @default(UNVERIFIED) @map("verification_status")
  extractionMethod       ExtractionMethod      @map("extraction_method")
  phoneRaw               String?               @map("phone_raw") @db.VarChar(50)
  phoneNormalized        String?               @map("phone_normalized") @db.VarChar(20)
  email                  String?               @db.VarChar(320)
  website                String?               @db.VarChar(2048)
  googlePlaceId          String?               @map("google_place_id") @db.VarChar(255)
  confidenceContribution Int                   @default(0) @map("confidence_contribution")
  rawSourceMetadata      Json?                 @map("raw_source_metadata") @db.JsonB
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead                   Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  approvedSource         ApprovedSource?       @relation(fields: [approvedSourceId], references: [id], onDelete: SetNull)

  @@index([leadId, sourceCollectedAt])
  @@index([approvedSourceId])
  @@index([sourceKey, sourceRecordId])
  @@index([phoneNormalized])
  @@index([googlePlaceId])
  @@map("lead_provenance")
}

model CsvImport {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  approvedSourceId  String?         @map("approved_source_id") @db.Uuid
  scrapingJobId     String?         @map("scraping_job_id") @db.Uuid
  originalFilename  String          @map("original_filename") @db.VarChar(255)
  sourceName        String          @map("source_name") @db.VarChar(150)
  fileSha256        String          @map("file_sha256") @db.Char(64)
  rightsConfirmedAt DateTime        @map("rights_confirmed_at") @db.Timestamptz(3)
  status            CsvImportStatus @default(PENDING)
  totalRows         Int             @default(0) @map("total_rows")
  validRows         Int             @default(0) @map("valid_rows")
  invalidRows       Int             @default(0) @map("invalid_rows")
  duplicateRows     Int             @default(0) @map("duplicate_rows")
  importedRows      Int             @default(0) @map("imported_rows")
  headerMapping     Json?           @map("header_mapping") @db.JsonB
  stagedRows        Json?           @map("staged_rows") @db.JsonB
  errorReport       Json?           @map("error_report") @db.JsonB
  startedAt         DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(3)
  failedAt          DateTime?       @map("failed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  approvedSource    ApprovedSource? @relation(fields: [approvedSourceId], references: [id], onDelete: SetNull)
  scrapingJob       ScrapingJob?    @relation(fields: [scrapingJobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([approvedSourceId])
  @@index([scrapingJobId])
  @@index([fileSha256])
  @@map("csv_imports")
}

model LeadVerification {
  id               String                 @id @default(uuid()) @db.Uuid
  leadId           String                 @map("lead_id") @db.Uuid
  verificationType String                 @map("verification_type") @db.VarChar(50)
  status           LeadVerificationStatus @map("status")
  provider         String                 @db.VarChar(100)
  checkedValueHash String?                @map("checked_value_hash") @db.VarChar(128)
  resultSummary    Json?                  @map("result_summary") @db.JsonB
  failureReason    String?                @map("failure_reason") @db.Text
  checkedAt        DateTime               @default(now()) @map("checked_at") @db.Timestamptz(3)
  expiresAt        DateTime?              @map("expires_at") @db.Timestamptz(3)
  createdByUserId  String?                @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  lead             Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdByUser    User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, checkedAt])
  @@index([verificationType, status])
  @@index([createdByUserId])
  @@map("lead_verifications")
}

model LeadDuplicateCandidate {
  id               String                   @id @default(uuid()) @db.Uuid
  primaryLeadId    String                   @map("primary_lead_id") @db.Uuid
  candidateLeadId  String                   @map("candidate_lead_id") @db.Uuid
  matchScore       Int                      @map("match_score")
  matchLevel       DuplicateMatchLevel      @map("match_level")
  matchReasons     Json                     @map("match_reasons") @db.JsonB
  status           DuplicateCandidateStatus @default(PENDING)
  reviewedByUserId String?                  @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?                @map("reviewed_at") @db.Timestamptz(3)
  reviewNotes      String?                  @map("review_notes") @db.Text
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  primaryLead      Lead                     @relation("PrimaryLead", fields: [primaryLeadId], references: [id], onDelete: Cascade)
  candidateLead    Lead                     @relation("CandidateLead", fields: [candidateLeadId], references: [id], onDelete: Cascade)
  reviewedByUser   User?                    @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([primaryLeadId, candidateLeadId])
  @@index([primaryLeadId, status])
  @@index([candidateLeadId, status])
  @@index([status])
  @@index([reviewedByUserId])
  @@map("lead_duplicate_candidates")
}

model LeadMergeHistory {
  id                String   @id @default(uuid()) @db.Uuid
  canonicalLeadId   String   @map("canonical_lead_id") @db.Uuid
  mergedLeadId      String   @map("merged_lead_id") @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  reason            String?  @db.Text
  preservedSnapshot Json     @map("preserved_snapshot") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  canonicalLead     Lead     @relation("CanonicalLead", fields: [canonicalLeadId], references: [id], onDelete: Cascade)
  mergedLead        Lead     @relation("MergedLead", fields: [mergedLeadId], references: [id], onDelete: Cascade)
  actorUser         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([canonicalLeadId])
  @@index([mergedLeadId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("lead_merge_histories")
}

model LeadQualityIssue {
  id               String               @id @default(uuid()) @db.Uuid
  leadId           String               @map("lead_id") @db.Uuid
  issueType        String               @map("issue_type") @db.VarChar(100)
  severity         QualityIssueSeverity
  fieldName        String?              @map("field_name") @db.VarChar(100)
  summary          String               @db.VarChar(500)
  status           QualityIssueStatus   @default(UNRESOLVED)
  resolvedAt       DateTime?            @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?              @map("resolved_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  lead             Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  resolvedByUser   User?                @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId, status])
  @@index([issueType, status])
  @@index([severity, status])
  @@index([resolvedByUserId])
  @@map("lead_quality_issues")
}

// ─── Billing Enums ────────────────────────────────────────────────────────────

enum BillingProvider {
  STRIPE
  MANUAL
  NONE
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  UNPAID
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

enum SubscriptionChangeType {
  CREATED
  TRIAL_STARTED
  ACTIVATED
  RENEWED
  UPGRADED
  DOWNGRADED
  CANCEL_SCHEDULED
  CANCELED
  PAUSED
  RESUMED
  PAYMENT_FAILED
  PAYMENT_SUCCEEDED
  EXPIRED
  ADMIN_UPDATED
}

enum UsageMetric {
  SCRAPING_JOBS
  REQUESTED_LEADS
  STORED_LEADS
  CSV_EXPORTS
  EXPORTED_LEADS
  API_REQUESTS
  WEBSITE_ENRICHMENTS
  PHONE_ENRICHMENTS
  TEAM_MEMBERS
}

enum UsageReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

// ─── Billing Models ───────────────────────────────────────────────────────────

/// Subscription plan definition. Key is stable and immutable.
model Plan {
  id                String          @id @default(uuid()) @db.Uuid
  key               String          @unique @db.VarChar(50)
  name              String          @db.VarChar(100)
  description       String?         @db.Text
  isActive          Boolean         @default(true) @map("is_active")
  isPublic          Boolean         @default(true) @map("is_public")
  billingProvider   BillingProvider @default(NONE) @map("billing_provider")
  providerProductId String?         @map("provider_product_id") @db.VarChar(255)
  displayOrder      Int             @default(0) @map("display_order")
  metadata          Json?           @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  prices        PlanPrice[]
  limits        PlanLimit[]
  subscriptions Subscription[]

  @@index([isActive, isPublic])
  @@index([displayOrder])
  @@map("plans")
}

/// Pricing for a plan at a specific billing interval.
model PlanPrice {
  id              String          @id @default(uuid()) @db.Uuid
  planId          String          @map("plan_id") @db.Uuid
  billingInterval BillingInterval @map("billing_interval")
  currency        String          @default("usd") @db.VarChar(3)
  /// Amount in minor currency units (e.g. cents). 0 = free.
  unitAmount      Int             @map("unit_amount")
  providerPriceId String?         @map("provider_price_id") @db.VarChar(255)
  trialDays       Int             @default(0) @map("trial_days")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([planId, billingInterval, currency])
  @@index([providerPriceId])
  @@map("plan_prices")
}

/// Usage limits per metric for a plan.
model PlanLimit {
  id            String      @id @default(uuid()) @db.Uuid
  planId        String      @map("plan_id") @db.Uuid
  metric        UsageMetric
  /// null = no hard limit (use softLimit or unlimited)
  hardLimit     Int?        @map("hard_limit")
  /// Soft warning threshold
  softLimit     Int?        @map("soft_limit")
  /// When true, this metric is unrestricted
  unlimited     Boolean     @default(false)
  /// Interval key for resets: "monthly" | "yearly" | "never"
  resetInterval String      @default("monthly") @map("reset_interval") @db.VarChar(20)
  metadata      Json?       @db.JsonB
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metric])
  @@index([planId])
  @@map("plan_limits")
}

/// Per-user billing profile linking to payment provider customer.
model CustomerBillingProfile {
  id                            String          @id @default(uuid()) @db.Uuid
  userId                        String          @unique @map("user_id") @db.Uuid
  billingProvider               BillingProvider @default(NONE) @map("billing_provider")
  providerCustomerId            String?         @unique @map("provider_customer_id") @db.VarChar(255)
  billingEmail                  String          @map("billing_email") @db.VarChar(320)
  businessName                  String?         @map("business_name") @db.VarChar(255)
  taxIdReference                String?         @map("tax_id_reference") @db.VarChar(100)
  billingAddress                Json?           @map("billing_address") @db.JsonB
  defaultPaymentMethodReference String?         @map("default_payment_method_reference") @db.VarChar(255)
  createdAt                     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerCustomerId])
  @@map("customer_billing_profiles")
}

/// Active subscription for a user.
model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  planPriceId            String?            @map("plan_price_id") @db.Uuid
  billingProfileId       String?            @map("billing_profile_id") @db.Uuid
  provider               BillingProvider    @default(NONE)
  providerSubscriptionId String?            @unique @map("provider_subscription_id") @db.VarChar(255)
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime           @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd       DateTime           @map("current_period_end") @db.Timestamptz(3)
  trialStart             DateTime?          @map("trial_start") @db.Timestamptz(3)
  trialEnd               DateTime?          @map("trial_end") @db.Timestamptz(3)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?          @map("canceled_at") @db.Timestamptz(3)
  endedAt                DateTime?          @map("ended_at") @db.Timestamptz(3)
  providerMetadata       Json?              @map("provider_metadata") @db.JsonB
  /// Optimistic concurrency version
  version                Int                @default(0)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  planPrice    PlanPrice?            @relation(fields: [planPriceId], references: [id], onDelete: SetNull)
  history      SubscriptionHistory[]
  usagePeriods UsagePeriod[]
  invoices     Invoice[]

  @@index([userId, status])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([providerSubscriptionId])
  @@map("subscriptions")
}

/// Immutable audit trail of subscription state changes.
model SubscriptionHistory {
  id              String                 @id @default(uuid()) @db.Uuid
  subscriptionId  String                 @map("subscription_id") @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  changeType      SubscriptionChangeType @map("change_type")
  previousPlanId  String?                @map("previous_plan_id") @db.Uuid
  newPlanId       String?                @map("new_plan_id") @db.Uuid
  previousStatus  SubscriptionStatus?    @map("previous_status")
  newStatus       SubscriptionStatus?    @map("new_status")
  effectiveAt     DateTime               @map("effective_at") @db.Timestamptz(3)
  actorUserId     String?                @map("actor_user_id") @db.Uuid
  reason          String?                @db.Text
  providerEventId String?                @map("provider_event_id") @db.VarChar(255)
  metadata        Json?                  @db.JsonB
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([userId])
  @@index([changeType])
  @@index([effectiveAt])
  @@map("subscription_history")
}

/// Tracks a billing period for usage measurement.
model UsagePeriod {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  subscriptionId String?  @map("subscription_id") @db.Uuid
  periodStart    DateTime @map("period_start") @db.Timestamptz(3)
  periodEnd      DateTime @map("period_end") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  counters     UsageCounter[]
  reservations UsageReservation[]

  @@unique([userId, periodStart, periodEnd])
  @@index([userId])
  @@index([subscriptionId])
  @@index([periodStart, periodEnd])
  @@map("usage_periods")
}

/// Atomic usage counter per metric within a billing period.
model UsageCounter {
  id            String      @id @default(uuid()) @db.Uuid
  usagePeriodId String      @map("usage_period_id") @db.Uuid
  metric        UsageMetric
  quantity      Int         @default(0)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  usagePeriod UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)

  @@unique([usagePeriodId, metric])
  @@index([usagePeriodId])
  @@map("usage_counters")
}

/// Pessimistic usage reservation for in-flight operations.
model UsageReservation {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  usagePeriodId  String                 @map("usage_period_id") @db.Uuid
  metric         UsageMetric
  quantity       Int
  status         UsageReservationStatus @default(RESERVED)
  /// Client-supplied idempotency key to prevent double-reservation
  idempotencyKey String                 @unique @map("idempotency_key") @db.VarChar(255)
  expiresAt      DateTime?              @map("expires_at") @db.Timestamptz(3)
  /// e.g. "scraping_job", "csv_export"
  referenceType  String                 @map("reference_type") @db.VarChar(100)
  referenceId    String?                @map("reference_id") @db.VarChar(255)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usagePeriod UsagePeriod @relation(fields: [usagePeriodId], references: [id], onDelete: Cascade)

  @@index([userId, metric, status])
  @@index([usagePeriodId])
  @@index([expiresAt])
  @@index([referenceType, referenceId])
  @@map("usage_reservations")
}

/// Invoice synced from billing provider.
model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  subscriptionId    String?         @map("subscription_id") @db.Uuid
  provider          BillingProvider
  providerInvoiceId String?         @unique @map("provider_invoice_id") @db.VarChar(255)
  number            String?         @db.VarChar(100)
  currency          String          @default("usd") @db.VarChar(3)
  subtotalAmount    Int             @map("subtotal_amount")
  taxAmount         Int             @default(0) @map("tax_amount")
  totalAmount       Int             @map("total_amount")
  amountPaid        Int             @default(0) @map("amount_paid")
  amountDue         Int             @map("amount_due")
  status            InvoiceStatus   @default(DRAFT)
  hostedInvoiceUrl  String?         @map("hosted_invoice_url") @db.VarChar(2048)
  invoicePdfUrl     String?         @map("invoice_pdf_url") @db.VarChar(2048)
  periodStart       DateTime?       @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime?       @map("period_end") @db.Timestamptz(3)
  dueAt             DateTime?       @map("due_at") @db.Timestamptz(3)
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([paidAt])
  @@map("invoices")
}

/// Payment record synced from billing provider.
model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  invoiceId         String?         @map("invoice_id") @db.Uuid
  provider          BillingProvider
  providerPaymentId String?         @unique @map("provider_payment_id") @db.VarChar(255)
  amount            Int
  currency          String          @default("usd") @db.VarChar(3)
  status            PaymentStatus   @default(PENDING)
  failureCode       String?         @map("failure_code") @db.VarChar(100)
  failureMessage    String?         @map("failure_message") @db.Text
  refundedAmount    Int             @default(0) @map("refunded_amount")
  paidAt            DateTime?       @map("paid_at") @db.Timestamptz(3)
  metadata          Json?           @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

/// Deduplication and audit record for billing provider webhook events.
model BillingWebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        BillingProvider
  /// Provider-assigned event ID for deduplication
  providerEventId String                  @unique @map("provider_event_id") @db.VarChar(255)
  eventType       String                  @map("event_type") @db.VarChar(100)
  /// SHA-256 hash of raw payload for integrity check
  payloadHash     String                  @map("payload_hash") @db.VarChar(64)
  status          WebhookProcessingStatus @default(RECEIVED)
  attempts        Int                     @default(0)
  lastError       String?                 @map("last_error") @db.Text
  receivedAt      DateTime                @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?               @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([provider, eventType])
  @@index([status])
  @@index([receivedAt])
  @@map("billing_webhook_events")
}
