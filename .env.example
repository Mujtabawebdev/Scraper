NODE_ENV=development

API_PORT=5000
WEB_PORT=5173

DATABASE_URL=postgresql://lead_user:lead_password@localhost:5432/us_business_leads?schema=public
DIRECT_DATABASE_URL=postgresql://lead_user:lead_password@localhost:5432/us_business_leads?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES_PER_REQUEST=

QUEUE_PREFIX=lead-saas
SCRAPING_QUEUE_NAME=scraping-jobs
WORKER_CONCURRENCY=2

SCRAPING_EXTERNAL_SOURCE_ENABLED=false
SCRAPING_APPROVED_BASE_URL=
SCRAPING_USER_AGENT=LeadSaaSResearchBot/0.1
SCRAPING_REQUEST_TIMEOUT_MS=10000
SCRAPING_MIN_DELAY_MS=1500
SCRAPING_MAX_PAGES_PER_JOB=5

JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_COOKIE_NAME=lead_saas_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/api/v1/auth

AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_REFRESH_RATE_LIMIT_WINDOW_MS=900000
AUTH_REFRESH_RATE_LIMIT_MAX=30

FRONTEND_URL=http://localhost:5173

VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_APP_NAME=US Business Lead SaaS

LOG_LEVEL=info
