{
  "name": "us-business-lead-saas",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready US business lead generation SaaS",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=@lead-saas/api",
    "dev:worker": "npm run dev --workspace=@lead-saas/worker",
    "dev:web": "npm run dev --workspace=@lead-saas/web",
    "docker:up": "docker compose up -d postgres redis",
    "docker:down": "docker compose down",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": { "node": ">=20" }
}
